# --- Secrets & Local Private Config ---
# Anchored: only the root runtime config is private (.cargo/config.toml is tracked).
/config.toml
*.local.toml
.env
*.pem
*.key
*.env
deploy/*.env
!*.env.example
deploy/proxmox.env
data/labels.json
data/power.json
data/speaker-plug.json
data/osc.json
data/update-prefs.json
data/presets/*.json
!data/presets/default.json

# --- Rust ---
/target/
**/*.rs.bk

# --- Frontend / Node.js / Svelte ---
frontend/node_modules/
frontend/dist/
.vite/

# --- OS & Editors ---
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp

# --- Claude Code local worktrees & settings ---
.claude/
