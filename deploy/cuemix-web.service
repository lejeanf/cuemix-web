[Unit]
Description=cuemix-web MOTU UltraLite-mk5 controller
Documentation=https://github.com/lejeanf/cuemix-web
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=cuemix
Group=cuemix
ExecStart=/usr/local/bin/cuemix-web --config /etc/cuemix-web/config.toml
WorkingDirectory=/var/lib/cuemix-web
Restart=on-failure
RestartSec=3

# Hardening: the service needs only its config (read), its state directory
# (read/write) and the network. No privilege escalation, no capabilities.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/cuemix-web
AmbientCapabilities=
CapabilityBoundingSet=
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
# Since 0.7.2: no devices, no other processes, no clock/hostname/kernel-log changes, no
# namespaces or realtime scheduling, no writable+executable memory, only the syscalls and
# address families a network service uses (AF_NETLINK: interface list for mDNS and the
# MOTU link), files private to the service by default.
PrivateDevices=yes
ProtectProc=invisible
ProcSubset=pid
ProtectClock=yes
ProtectHostname=yes
ProtectKernelLogs=yes
RestrictNamespaces=yes
RestrictRealtime=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
SystemCallErrorNumber=EPERM
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
UMask=0077
# Resource ceilings: a flood of connections cannot take the whole container down.
MemoryMax=256M
TasksMax=256
LimitNOFILE=4096

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
