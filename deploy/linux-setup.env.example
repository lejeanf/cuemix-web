# Linux (SBC / bare metal) setup variables.
# Copy to deploy/linux-setup.env (git-ignored) and adjust.

# CIDR address assigned to the MOTU link-local interface.
MOTU_IFACE_IP="169.254.254.1/16"
# Directory where the cuemix-web binary is installed.
INSTALL_DIR="/usr/local/bin"
# System user that runs the cuemix-web service.
SERVICE_USER="cuemix"
# HTTP bind address (host:port) for the web interface.
HTTP_BIND="0.0.0.0:8080"
# UDP port used for OSC control.
OSC_PORT=8000
