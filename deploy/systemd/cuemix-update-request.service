[Unit]
Description=cuemix-web: install the update requested from the web UI
Documentation=https://github.com/lejeanf/cuemix-web

[Service]
Type=oneshot
# An install waits for the lock, downloads, restarts and health-checks: generous, but never forever.
TimeoutStartSec=15min
# The request file is written by the unprivileged web service: cuemix-update reads it as
# untrusted input (64 bytes at most; empty = newest release of the channel, or one release
# tag such as v0.7.2, older ones down to the version floor), removes it, installs (sha256 check, health check,
# automatic rollback), records the exit code for the UI in update-result and refreshes
# update-status.json (both built in the root-only /var/lib/cuemix-update, then renamed into
# place). Its content never goes through a shell.
ExecStart=/usr/local/sbin/cuemix-update --run-request /var/lib/cuemix-web/update-request --result-file /var/lib/cuemix-web/update-result --status-file /var/lib/cuemix-web/update-status.json
# Since 0.7.2: runs as root, but may only write the binary, the two state directories, its
# lock in /run and a private /tmp.
ProtectSystem=strict
ReadWritePaths=/usr/local/bin /var/lib/cuemix-web /run
# /var/lib/cuemix-update, root-only (0700), created by systemd if missing.
StateDirectory=cuemix-update
StateDirectoryMode=0700
PrivateTmp=yes
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
# Safety net: whatever happened, the request is gone so the path unit does not fire again.
ExecStopPost=-/bin/rm -f /var/lib/cuemix-web/update-request
