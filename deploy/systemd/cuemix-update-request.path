[Unit]
Description=cuemix-web: watch for an update requested from the web UI

[Path]
# A request that cannot be removed (for example a directory planted at the path) must not
# make this unit spin: after a few starts in a minute systemd stops triggering.
TriggerLimitIntervalSec=1min
TriggerLimitBurst=5
# Created by the unprivileged web service when the user presses Install: empty, or holding
# one release tag. cuemix-update validates it strictly before using it.
PathExists=/var/lib/cuemix-web/update-request
Unit=cuemix-update-request.service

[Install]
WantedBy=multi-user.target
